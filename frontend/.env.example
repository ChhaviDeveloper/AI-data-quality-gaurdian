# Base URL of the deployed dashboard-api Cloud Run service, e.g.
# https://dashboard-api-xxxxx-ew.a.run.app
# Leave unset to run the frontend standalone against built-in mock data
# (handy for demoing the UI before the pipeline is fully deployed).
NEXT_PUBLIC_API_BASE_URL=

# Looker Studio report embed URL for the Analytics page, e.g.
# https://lookerstudio.google.com/embed/reporting/<report-id>/page/<page-id>
# See "Looker Studio setup" in the README for how to build the report and
# get this URL. Leave unset to show a placeholder on the Analytics page.
NEXT_PUBLIC_LOOKER_EMBED_URL=
